# Site kök URL (PayTR yönlendirme adresleri için)
SITE_URL=https://onlinevipdershane.com

# PayTR — https://www.paytr.com/magaza/bilgi
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Test modu: 1 = test, 0 veya boş = canlı
PAYTR_TEST_MODE=0

# Stripe (opsiyonel — PayTR yoksa kullanılır)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Ders Online VIP Koçluk paneli (öğretmen listesi + özel ders talepleri + kitap ödeme)
KOCLUK_PANEL_URL=https://www.dersonlinevipkocluk.com
OZEL_DERS_WEBHOOK_SECRET=
# Kitap checkout token (boşsa OZEL_DERS_WEBHOOK_SECRET kullanılır; panel ile aynı olmalı)
COMMERCE_CHECKOUT_SECRET=

# Panel → site öğretmen yayın sync (HMAC). Panel env ile AYNI secret olmalı.
# Panel: SITE_TEACHERS_WEBHOOK_URL=https://onlinevipdershane.com/api/teachers-sync
SITE_TEACHERS_WEBHOOK_SECRET=

# Formspree (iletişim / analiz bildirimleri)
FORMSPREE_FORM_ID=

# Kommo CRM
KOMMO_SUBDOMAIN=
KOMMO_ACCESS_TOKEN=
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=
KOMMO_RESPONSIBLE_USER_ID=

# Ücretsiz öğrenci analizi
ASSESSMENT_TOKEN_SECRET=
ASSESSMENT_ADMIN_KEY=
CRON_SECRET=

# Opsiyonel kalıcı kayıt (Supabase). Boşsa lead Formspree + Kommo + imzalı token ile çalışır.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (Twilio). Boşsa mesaj gönderilmez; başvuru kaydı devam eder.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
